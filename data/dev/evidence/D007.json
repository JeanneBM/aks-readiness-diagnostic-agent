{
  "schema": 1,
  "target": "demo/api",
  "observations": [
    {
      "id": "status",
      "kind": "pod_status",
      "source": "synthetic/pod/status",
      "text": "Ready=False"
    },
    {
      "id": "probe",
      "kind": "probe_config",
      "source": "synthetic/pod/spec",
      "text": "{\"port\": 8080, \"path\": \"/ready\", \"scheme\": \"HTTP\"}"
    },
    {
      "id": "events",
      "kind": "probe_result",
      "source": "synthetic/events",
      "text": "Readiness probe failed: HTTP probe failed with statuscode: 503"
    },
    {
      "id": "logs",
      "kind": "app_log",
      "source": "synthetic/application",
      "text": "Dependency check failed: inventory\nApplication cannot declare readiness."
    }
  ]
}
